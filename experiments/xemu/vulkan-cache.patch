 {
+    save_spirv_cache();
+    g_mutex_lock(&spirv_cache_lock);
+    if (spirv_cache) {
+        g_hash_table_destroy(spirv_cache);
+        spirv_cache = NULL;
+    }
+    g_mutex_unlock(&spirv_cache_lock);
     glslang_finalize_process();
 }
 
