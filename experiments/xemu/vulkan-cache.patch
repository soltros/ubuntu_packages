                         } };
 
+static bool spirv_atexit_registered;
+
 void pgraph_vk_init_glsl_compiler(void)
 {
     glslang_initialize_process();
+    load_spirv_cache();
+    if (!spirv_atexit_registered) {
+        atexit(save_spirv_cache);
+        spirv_atexit_registered = true;
+    }
 }
 
